<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.keibaai.backfill</string>

  <!-- 過去の重賞の過去10年と出走馬の成績を、さかのぼって取得（server/scripts/run-history-backfill.ts）。
       毎日動き、ほかの自動取得（夜間 1:00・オッズ 9:30/12:00・出馬表 10:40/13:00・木曜 14:30/16:00/21:00）の5分前に止まる。
       ほかの取得の実行中は何もせずに終わる。曜日と時刻の判定はスクリプト側。caffeinate でスリープを防ぐ。ログは日付ごと -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>cd /Users/tsuchiyayuri/keibaai &amp;&amp; /usr/bin/caffeinate -i /usr/local/bin/npx tsx server/scripts/run-history-backfill.ts &gt;&gt; logs/backfill-$(date +%Y%m%d).log 2&gt;&amp;1</string>
  </array>

  <!-- npx が node を見つけられるように PATH を指定 -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <!-- 毎時 7分・37分に起動を試みる（ほかの自動取得の 0分・30分・40分と重ならないように） -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Minute</key><integer>7</integer>
    </dict>
    <dict>
      <key>Minute</key><integer>37</integer>
    </dict>
  </array>

  <key>StandardErrorPath</key>
  <string>/Users/tsuchiyayuri/keibaai/logs/backfill-launchd-error.log</string>
</dict>
</plist>
